{
  "name": "@litela-hq/hono-rpc-msw-adapter",
  "version": "0.0.3",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Litela-HQ/hono-rpc-msw-adapter.git"
  },
  "homepage": "https://github.com/Litela-HQ/hono-rpc-msw-adapter",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "@hono-rpc-msw-adapter/src": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./register": {
      "@hono-rpc-msw-adapter/src": "./src/register.ts",
      "types": "./dist/register.d.mts",
      "import": "./dist/register.mjs",
      "require": "./dist/register.cjs",
      "default": "./dist/register.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "run-s 'typecheck:*'",
    "typecheck:package": "tsc --noEmit",
    "typecheck:examples": "turbo run typecheck",
    "lint": "run-s 'lint:*'",
    "lint:oxlint": "oxlint --type-aware --ignore-path .gitignore --report-unused-disable-directives --tsconfig ./tsconfig.json",
    "lint:oxfmt": "pnpm fix:oxfmt --check",
    "fix": "run-s 'fix:*'",
    "fix:oxlint": "pnpm lint:oxlint --fix --fix-suggestions --fix-dangerously",
    "fix:oxfmt": "oxfmt --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "test": "run-s 'test:*'",
    "test:package": "vitest run",
    "test:examples": "pnpm build && turbo run test"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@vitest/ui": "catalog:",
    "hono": "catalog:",
    "lefthook": "catalog:",
    "msw": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "release-it": "catalog:",
    "release-it-pnpm": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "hono": "^4.11.1",
    "msw": "^2.12.4"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
